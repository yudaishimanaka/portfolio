---
// src/pages/index.astro
import Layout from '../layouts/BaseLayout.astro';
import { Github, NotebookText } from 'lucide-astro';
---

<Layout 
  title="yudai.dev"
  description="yudai shimanakaのポートフォリオ"
>
	<div class="min-h-[calc(100vh-7rem)] flex items-center">
		<!-- profile -->
		<section id="profile" class="mb-10 w-full">
			<h1 class="text-4xl font-bold mb-4">
				yudai shimanaka
			</h1>
			<p class="text-2xl font-bold mb-4">
				web/infrastructure engineer
			</p>

			<!-- social icon -->
			<div class="flex mb-4">

				<!-- X (Twitter) -->
				<a
					href="https://x.com/yudaideath"
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center pr-4"
					title="X (Twitter)"
				>
					<svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
						<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
					</svg>
				</a>

				<!-- GitHub -->
				<a
					href="https://github.com/yudaishimanaka"
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center pr-4"
					title="GitHub"
				>
					<Github size={32} />
				</a>
			</div>

			<!-- note link -->
			<div class="mt-14">
				<a
					href="/note"
					class="inline-flex items-center gap-2 px-4 py-2 bg-zinc-900 text-zinc-50 rounded-lg hover:bg-zinc-800 transition-colors"
				>
					<NotebookText size={24} />
					<span class="font-bold">Notes</span>
				</a>
			</div>
		</section>
	</div>


</Layout>
