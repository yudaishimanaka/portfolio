---
// src/pages/note/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/BaseLayout.astro';

// publicがtrueの記事のみ取得し、公開日順でソート
const notes = (await getCollection('note', ({ data }) => {
  return data.public === true;
})).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<Layout title="Notes | yudai.dev" description="技術記事やメモを掲載しています">
  <div class="w-full pt-7">
    <h1 class="sticky top-14 bg-zinc-50 z-40 text-4xl font-bold mb-8">Notes</h1>
    
    <div class="mx-auto">
    {notes.length === 0 ? (
      <p class="text-xl font-bold text-zinc-800">
        表示するノートがありません。
      </p>
    ) : (
      <div class="space-y-6">
        {notes.map((note) => {
          const formattedDate = note.data.publishedAt.toLocaleDateString('ja-JP', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
          
          return (
            <article>
              <a href={`/note/${note.data.id}`} class="group">
                <h2 class="text-xl font-bold mb-2 text-zinc-800 group-hover:text-blue-600 transition-colors">
                  {note.data.title}
                </h2>
                
                <div class="flex items-center gap-4 text-sm text-zinc-600 mb-3">
                  <time datetime={note.data.publishedAt.toISOString()}>
                    {formattedDate}
                  </time>
                </div>

                {note.data.description && (
                  <p class="text-sm text-zinc-700 mb-3 line-clamp-2">
                    {note.data.description}
                  </p>
                )}

                {note.data.tags && note.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {note.data.tags.map((tag) => (
                      <span class="px-2 py-1 bg-zinc-200 text-zinc-800 rounded text-xs">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            </article>
          );
        })}
      </div>
    )}
    </div>
  </div>
</Layout>
