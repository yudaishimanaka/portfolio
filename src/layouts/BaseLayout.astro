---
// src/layouts/BaseLayout.astro
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'yudai.dev', 
  description = 'yudai shimanakaのポートフォリオ' 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Outfit:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-zinc-50 text-zinc-900">
    <header class="fixed top-0 left-0 right-0 w-full mx-auto max-w-4xl flex h-14 items-center justify-between px-6 bg-zinc-50 z-[100]">
      <div class="flex items-center">
        <a href="/" class="text-2xl font-bold">
          <span id="header-typewriter-text"></span><span id="header-typewriter-cursor" class="inline-block">|</span>
        </a>
      </div>
    </header>

    <main class="content-wrapper mt-7 pt-7 pb-14 flex-1 ">
      <slot />
    </main>
    
    <footer class="fixed bottom-0 left-0 right-0 w-full mx-auto max-w-7xl flex h-14 items-center justify-center px-6 bg-zinc-50">
      <div class="text-base font-bold text-zinc-600 font-inter">
        <a href="/" class="text-zinc-600 hover:text-zinc-800 hover:no-underline">
          © {new Date().getFullYear()} {title}
        </a>
      </div>
    </footer>
  </body>
</html>

<script>
  // ヘッダー用タイプライターエフェクト
  const headerText = "yudai.dev";
  const headerTextElement = document.getElementById("header-typewriter-text");
  const headerCursorElement = document.getElementById("header-typewriter-cursor");
  let headerIndex = 0;

  function headerTypeWriter() {
    if (headerIndex < headerText.length && headerTextElement) {
      headerTextElement.textContent += headerText.charAt(headerIndex);
      headerIndex++;
      setTimeout(headerTypeWriter, 50);
    }
  }

  // ヘッダーのカーソル点滅
  setInterval(() => {
    if (headerCursorElement) {
      headerCursorElement.style.opacity = headerCursorElement.style.opacity === "0" ? "1" : "0";
    }
  }, 600);

  window.addEventListener("DOMContentLoaded", headerTypeWriter);
</script>
